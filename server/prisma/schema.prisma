generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id    Int     @id @default(autoincrement())
    email String  @unique
    name  String?
}

// Technology schema 

enum Tech_Stack {
    FRONTEND
    BACKEND
    DATABASE
    TOOLS
    DATA_SCIENCE
    LIBRARIES
}

model Technology {
    name      String     @id
    category  Tech_Stack
    createdAt DateTime   @default(now())
    isDeleted Boolean    @default(false)
    deletedAt DateTime?
}
